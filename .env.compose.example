# Copy this file to the repository root as .env.
# Use a long, random, URL-safe password (letters and numbers only).
POSTGRES_DB=studyflow_db
POSTGRES_USER=studyflow
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
HOST_PORT=8000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000

# For a public HTTPS deployment, set these to the real public URL.
PUBLIC_APP_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8000/app
