# Replace with a private random value containing at least 32 bytes.
SECRET_KEY=replace-with-a-private-random-value-at-least-32-bytes
DATABASE_URL=postgresql+psycopg://localhost/studyflow_db
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=StudyFlow AI
WEBAUTHN_ORIGIN=http://localhost:8000
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-2.5-flare
# Optional separate image API endpoint; otherwise AI_BASE_URL is used.
# AI_IMAGE_BASE_URL=https://api.openai.com/v1
# GlobalPay hosted checkout (merchant credentials are provided by GlobalPay).
GLOBALPAY_ENV=sandbox
GLOBALPAY_USERNAME=
GLOBALPAY_PASSWORD=
GLOBALPAY_SERVICE_ID=
PUBLIC_APP_URL=http://localhost:8000
# Gmail SMTP. Use a Google App Password, not the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:8000/app
# Optional OpenAI-compatible API base URL; leave the default for OpenAI.
# AI_BASE_URL=https://api.openai.com/v1
