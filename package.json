{
  "name": "studyflow-quality",
  "private": true,
  "scripts": {
    "format": "git ls-files -z -- '*.js' '*.mjs' '*.css' '*.html' '*.json' '*.md' '*.yaml' '*.yml' | xargs -0 prettier --write",
    "format:check": "git ls-files -z -- '*.js' '*.mjs' '*.css' '*.html' '*.json' '*.md' '*.yaml' '*.yml' | xargs -0 prettier --check",
    "lint": "eslint --max-warnings 0 apps/web"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.8.1"
  }
}
